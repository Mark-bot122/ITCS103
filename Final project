def saving():
    if not input_validation():
        return
    
    day = day_entry.get()
    wrk = wrk_entry.get()
    bdy_weight = bdy_entry.get()
    reps = reps_entry.get()
    set = set_entry.get()

    workbook = op.load_workbook("Gregorio_Database.xlsx")
    sheet=workbook.active

    sheet.append([day,wrk,bdy_weight,reps,set])
    workbook.save("Gregorio_Database.xlsx")

    messagebox.showinfo("Success","Record added successfully!")
    display()
# upddating
def update():
    selected = tree.focus()

    if not selected:
        messagebox.showerror("Error","Select a record first.")

    if not input_validation():
        return
    
    values = tree.item(selected,"values")
    old_day = values[0]

    day = day_entry.get()
    wrk = wrk_entry.get()
    bdy_weight = bdy_entry.get()
    reps = reps_entry.get()
    set = set_entry.get()


    workbook = op.load_workbook("Gregorio_Database.xlsx")
    sheet = workbook.active

    for rows in sheet.iter_rows(min_row=2):
        if rows[0].value == old_day:
            rows[0].value = day
            rows[1].value = wrk
            rows[2].value = bdy_weight
            rows[3].value = reps
            rows[4].value = set
    
    workbook.save("Gregorio_Database.xlsx")
    messagebox.showinfo("Success","Record updated successfully!")
    display()
# deleting
def delete():
    selected = tree.focus()

    if not selected:
        messagebox.showerror("Error","Select a record first!")

    values = tree.item(selected,"values")
    old_day = values[0]

    confirm = messagebox.askyesnocancel("Confirm","Are you sure you want to delete this record?")
    
    if not confirm:
        return

    workbook = op.load_workbook("Gregorio_Database.xlsx")
    sheet = workbook.active

    for i,row in enumerate(sheet.iter_rows(min_row=2),start=2):
        if row[0].value == old_day:
            sheet.delete_rows(i)
            break

    workbook.save("Gregorio_Database.xlsx")
    messagebox.showinfo("Success","Record deleted successfully")
    display()

